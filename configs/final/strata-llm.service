[Unit]
Description=Strata API

[Service]
Type=simple
WorkingDirectory=/home/shinsuke/strata-data/config
Environment=PYTHONUNBUFFERED=1
Environment=STRATA_ENGINE_BACKEND=cuda
Environment=STRATA_NV_CHUNK=1
Environment=STRATA_POOL_SPIN_US=2000
Environment=STRATA_ADAPT_LAG=2
Environment=STRATA_ADAPT_NOWAIT=1
Environment=STRATA_CPU_IQ_ALL_EXACT1=1
Environment=STRATA_SIDE_MIXER=2
Environment=STRATA_ATTN_DAILY=1
Environment=STRATA_GR_UP75=1
Environment=STRATA_GU_SWIGLU=1
Environment=STRATA_QSA_ROWS=1
Environment=STRATA_B6_MMVQ_ROWS=1
Environment=STRATA_HC_UPMIX=1
Environment=STRATA_L2_PF=1
Environment=STRATA_Q80_ROWS1=1
Environment=STRATA_EXP_MODE=8
Environment=STRATA_ROUTE_TAIL_SKIP=7
UMask=0077
ExecStart=/home/shinsuke/.local/bin/strata serve --profile /home/shinsuke/strata-data/config/strata-ud-iq3_xxs.json --host 127.0.0.1 --port 18080
Restart=no
KillMode=control-group
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
